# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info/
*.h5
*.db
*.pkl
*.pt
*.mcap

# Keep test fixtures (parity checkpoints/tensors) even though *.pt / *.h5 are ignored
!tests/fixtures/**

# Virtual environments
.venv/

# Staged datasets. docs/DATA.md has the reader symlink their download to
# src/datasets/<cable>; nothing under it is tracked, so ignoring the whole
# directory keeps `git status` clean while the data is staged.
src/datasets/

# Run outputs
results/
results_eval/
wandb/
log/

# Tool caches
.ruff_cache/
.pytest_cache/

# VS Code
# .vscode/
*.vc.db-shm
